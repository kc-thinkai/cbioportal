# Copy to .env (repo root) or dev/.env and fill in values.
# Never commit files containing real secrets.

# --- Local deployment (optional) ---
# Folder containing application.properties and security.properties.
# See src/main/resources/*.EXAMPLE for templates.
# PORTAL_HOME=/path/to/cbioportal-config

# --- dev/docker-compose.yml (copy relevant lines to dev/.env) ---
DOCKER_IMAGE_SESSION_SERVICE=cbioportal/session-service:0.6.1
DOCKER_IMAGE_MYSQL=mysql:8.1.0
DOCKER_IMAGE_KEYCLOAK=quay.io/keycloak/keycloak:23.0
DOCKER_IMAGE_MONGODB=mongo:4.2

# --- Integration tests (./mvnw verify -Pintegration-test) ---
# TEST_DB_CLICKHOUSE_URL=jdbc:ch:https://localhost:8443/cbioportal
# TEST_DB_CLICKHOUSE_USERNAME=app_user
TEST_DB_CLICKHOUSE_PASSWORD=
# TEST_DB_CLICKHOUSE_DRIVER=com.clickhouse.jdbc.ClickHouseDriver
# TEST_DB_MYSQL_URL=jdbc:mysql://localhost:3306/cbioportal
# TEST_DB_MYSQL_USERNAME=cbio_user
TEST_DB_MYSQL_PASSWORD=
# TEST_DB_MYSQL_DRIVER=com.mysql.cj.jdbc.Driver

# --- E2E / API tests (src/e2e/js) ---
# CBIOPORTAL_URL=http://localhost:8080
